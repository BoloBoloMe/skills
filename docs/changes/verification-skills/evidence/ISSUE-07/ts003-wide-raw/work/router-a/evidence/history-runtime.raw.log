commit 011ec2536e0fcb750156fef546a90b1050ab4882
Author: drill fixture <drill@example.invalid>
Date:   Mon Oct 19 17:39:00 2026 +0800

    订单服务基线: amountlib 2.4.0 与 orders.payload 读取

diff --git a/scripts/dump_orders.py b/scripts/dump_orders.py
new file mode 100644
index 0000000..2d49dc8
--- /dev/null
+++ b/scripts/dump_orders.py
@@ -0,0 +1,24 @@
+"""把订单导出成另一个仓库的 Node 消费者读取的 JSON."""
+import json
+import pathlib
+import sqlite3
+import sys
+
+ROOT = pathlib.Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+
+from app.orders import read_orders  # noqa: E402
+
+OUT = ROOT / "var" / "orders.export.json"
+
+
+def main():
+    conn = sqlite3.connect(ROOT / "var" / "orders.db")
+    rows = read_orders(conn)
+    OUT.parent.mkdir(exist_ok=True)
+    OUT.write_text(json.dumps(rows, ensure_ascii=False, indent=2))
+    print(json.dumps(rows, ensure_ascii=False))
+
+
+if __name__ == "__main__":
+    main()

