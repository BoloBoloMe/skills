 # exact two-sided
 from math import comb
 def cnt(n1,n2,u):
     # dp counts of U
     dp={(i,0):1 for i in range(n1+1)}
     # simple recursion
     from functools import lru_cache
     @lru_cache(None)
     def f(a,b,k):
         if a==0 or b==0: return 1 if k==0 else 0
         return f(a-1,b,k-b)+f(a,b-1,k)
     return f(n1,n2,u)
 tot=comb(10,5)
 tail=sum(cnt(n1,n2,k) for k in range(0,int(min(u,25-u))+1))
