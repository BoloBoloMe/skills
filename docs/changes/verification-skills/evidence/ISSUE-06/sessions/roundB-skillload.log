 a       n=6 min=73.3 p50=73.5 max=75.8 {'returned': 5, 'ok': 5, 'err': 0}
 b       n=6 min=82.1 p50=82.1 max=83.7 {'returned': 5, 'ok': 3, 'err': 2}
