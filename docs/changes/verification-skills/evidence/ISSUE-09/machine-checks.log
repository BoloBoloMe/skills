扫描命令摘要 (第 3 项):
uv run python - <<'EOF'
import pathlib
ranges = [(0x3000,0x303F),(0xFF00,0xFFEF),(0x2018,0x201F),(0xFE10,0xFE1F)]
bad = lambda ch: any(a <= ord(ch) <= b for a, b in ranges)
paths = list(pathlib.Path("workflow/benchmark-checklist").rglob("*"))
paths += list(pathlib.Path("docs/changes/verification-skills/evidence/ISSUE-09").rglob("*.md"))
hits = 0
for p in paths:
    if not p.is_file():
        continue
    for n, line in enumerate(p.read_text(encoding="utf-8", errors="replace").splitlines(), 1):
        chars = [c for c in line if bad(c)]
        if chars:
            hits += 1
            print(f"{p}:{n}: " + " ".join(f"U+{ord(c):04X}" for c in chars))
print("hits=", hits)
EOF
