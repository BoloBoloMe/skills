 """非正式一次性实验: 与 bench/micro.py 相同跑法, 但把 fast 放在第一次, 看顺序效应."""                                                                           │
 import sys, time                                                                                                                                                │
 from pathlib import Path                                                                                                                                        │
 ROOT = Path("/tmp/orchestra-19/green2-lab")                                                                                                                     │
