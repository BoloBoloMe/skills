from pathlib import Path
import subprocess
base = "8b39649715f1aa4930e69004b0d9c706e08b7553"
target = "dcf06358c9a9ecff600228fa5eb300a65deec46e"
def text(commit, path):
    return subprocess.run(["git", "show", commit + ":" + path], check=True, capture_output=True, text=True).stdout
old = text(base, "workflow/domain-awareness/WORKFLOW_VOCABULARY.md")
new = text(target, "workflow/software-engineering-consensus/SKILL.md")
old_def = old[old.index("**权威输入**:"):old.index("## 收录标准")].strip()
new_def = new[new.index("**权威输入**:"):new.index("## 收录维护规则")].strip()
checks = []
checks.append(("两条旧定义及避免项, 仅将盘问用户改为盘问我", old_def.replace("盘问用户", "盘问我") == new_def))
p = "workflow/domain-awareness/SKILL.md"
expected = text(base, p).replace(", 直接读 `WORKFLOW_VOCABULARY.md`", "").replace("; 输出恒定包含指向 `WORKFLOW_VOCABULARY.md` 的引用, 无论探测结果如何.", ".")
checks.append(("领域感知仅删除指定两处分句, 其余逐字保留", expected == text(target, p)))
for p, count in [("workflow/maintain-verification-skill/SKILL.md", 2), ("workflow/maintain-verification-skill/reference/drift-classification.md", 1)]:
    original = text(base, p)
    checks.append((p + " 仅替换失败迭代为失败尝试, 原命中数=" + str(original.count("失败迭代")), original.count("失败迭代") == count and original.replace("失败迭代", "失败尝试") == text(target, p)))
checks.append(("旧文件在当前工作区不存在", not Path("workflow/domain-awareness/WORKFLOW_VOCABULARY.md").exists()))
for p in ["README.md", "workflow/software-engineering-consensus/SKILL.md", "workflow/domain-awareness/SKILL.md", "workflow/maintain-verification-skill/SKILL.md", "workflow/maintain-verification-skill/reference/drift-classification.md", "general/writing-for-llm/check_skill.py", "docs/changes/workflow-stack-review/ACCEPTANCE.md", "docs/changes/workflow-stack-review/milestone-01/DECISIONS.md", "agent-prompts/PUBLIC.md"]:
    source = subprocess.run(["git", "show", target + ":" + p], check=True, capture_output=True).stdout
    checks.append((p + " 当前逐字节等于目标提交", source == Path(p).read_bytes()))
for label, ok in checks:
    print(("一致: " if ok else "不一致: ") + label)
raise SystemExit(0 if all(ok for _, ok in checks) else 1)
