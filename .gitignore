# 默认忽略的文件
/shelf/
/workspace.xml
# 基于编辑器的 HTTP 客户端请求
/httpRequests/
# 已忽略包含查询文件的默认文件夹
/queries/
# Datasource local storage ignored files
/dataSources/
/dataSources.local.xml
/.idea/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
*.egg

# 测试 & 缓存
.pytest_cache/

# 包管理器锁文件 (从 pyproject.toml 可重建);
# 例外: general/ 下 skill 项目的 uv.lock 必须入库并部署 — 容器内 skill 树只读,
# 离线环境靠 lock 对齐镜像 venv, 现场重解析既写不进也无网.
uv.lock
!general/**/uv.lock
poetry.lock
Pipfile.lock

# 系统 & IDE
.DS_Store
node_modules/
/.pi-subagents/
