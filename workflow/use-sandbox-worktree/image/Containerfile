# M03 冒烟镜像定义 (localhost/swt-m03, M12 e2e 测试用极简形态), 不是真实 base 层.
# 真实三层镜像 (base/display/项目层) 由 image-prep.py 生成与构建 (D039).
FROM docker.io/library/node:24-bookworm-slim

RUN apt-get update \
    && apt-get install --no-install-recommends -y git openssh-server \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash bolo \
    && ssh-keygen -A \
    && mkdir -p /run/sshd \
    && chmod 755 /run/sshd \
    && sed -i 's/^#\?PermitUserEnvironment.*/PermitUserEnvironment yes/' /etc/ssh/sshd_config

RUN npm i -g @earendil-works/pi-coding-agent

WORKDIR /home/bolo

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D", "-e"]
